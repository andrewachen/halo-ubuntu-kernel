# noble series definition — sourced by scripts/lib/apt-src.sh and helpers.
SERIES=noble
SOURCE_PKG=linux-hwe-7.0
PATCHSET=v7.0
POCKETS="noble noble-updates noble-security"
# noble's packaging pins gcc-13, which rejects znver5 — the build passes
# COMPILER_OVERRIDE as a debian/rules command-line variable (gcc=gcc-14)
COMPILER_OVERRIDE=gcc-14
# Ubuntu no longer ships modules-extra: formerly-extra modules are split into
# linux-main-modules-* debs. SPLIT_MODULES lists the ones the stock meta
# depends on (verified against stock linux-image-generic-hwe-24.04's Depends
# at 7.0.0-38.38~24.04.4) — our meta pins Ubuntu's own debs at the stock EVR.
SPLIT_MODULES="zfs v4l2loopback"
