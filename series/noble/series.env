# noble series definition — sourced by scripts/lib/apt-src.sh and helpers.
SERIES=noble
SOURCE_PKG=linux-hwe-7.0
PATCHSET=v7.0
POCKETS="noble noble-updates noble-security"
# noble's packaging pins gcc-13, which rejects znver5 — the build passes
# COMPILER_OVERRIDE as a debian/rules command-line variable (gcc=gcc-14)
COMPILER_OVERRIDE=gcc-14
