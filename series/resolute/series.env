# resolute series definition — sourced by scripts/lib/apt-src.sh and helpers.
SERIES=resolute
SOURCE_PKG=linux
PATCHSET=v7.0
POCKETS="resolute resolute-updates resolute-security"
# the packaging's native gcc-15 is already znver5-capable: no override
COMPILER_OVERRIDE=
# split modules the stock meta depends on (verified against stock
# linux-image-generic's Depends at 7.0.0-38.38 — zfs only there)
SPLIT_MODULES="zfs"
